    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Каков порядок проведения аудита информационной безопасности?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Проведение аудита ИБ идёт в 5 этапов: планирование, сбор данных, тестирование, анализ, отчёт с ретестом. До старта заказчик подписывает NDA и разрешение на тестирование."
          }
        },
        {
          "@type": "Question",
          "name": "Каковы 4 этапа аудита?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Классическая схема аудита включает 4 этапа: планирование, сбор данных, анализ и отчёт. Технический аудит информационной безопасности добавляет пятый этап, тестирование систем, между сбором данных и анализом."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько времени занимает аудит информационной безопасности?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Аудит сайта длится от 5 рабочих дней, внутренней сети от 4 недель по данным RTM Group на 29.09.2026. Red Teaming занимает несколько месяцев."
          }
        }
      ]
